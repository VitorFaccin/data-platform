# Copy to .env and adjust. Compose reads this file automatically.

# Airflow 3 signs the tokens between api-server and task runners with this secret.
# Any random string works locally; generate one per environment.
AIRFLOW_JWT_SECRET=change-me-openssl-rand-hex-32

# Postgres (metadata database) — local defaults, never reused anywhere real.
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Where the pipeline writes: "local" (Delta tables under ./warehouse) or "gcp"
# (GCS lakehouse + BigQuery gold — requires infra/ applied and Application Default
# Credentials).
DATA_PLATFORM_SINK=local

# Only read when DATA_PLATFORM_SINK=gcp.
GCP_PROJECT_ID=
GCS_LANDING_BUCKET=
GCS_LAKEHOUSE_BUCKET=
BQ_DATASET_GOLD=gold

# Service-account key file name inside ./secrets/ (see secrets/README.md). Mounted
# read-only; compose points GOOGLE_APPLICATION_CREDENTIALS at it.
GCP_SA_KEY_FILE=gcp-sa.json

# Incoming-webhook URL of the Google Chat space that receives task-failure alerts
# (Space → Apps & integrations → Webhooks). It embeds a key and a token: treat it as a
# secret. Empty = alerts degrade to a log warning.
GOOGLE_CHAT_WEBHOOK_URL=
