# Copy to .env and adjust. Compose reads this file automatically.

# Airflow 3 signs the tokens between api-server and task runners with this secret.
# Any random string works locally; generate one per environment.
AIRFLOW_JWT_SECRET=change-me-openssl-rand-hex-32

# Postgres (metadata database) — local defaults, never reused anywhere real.
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# THE SWITCH — where data lands and where secrets come from (include/runtime.py):
#   local  (default) landing files and Delta tables in the `warehouse` Docker volume;
#          secrets from this file.
#   cloud  landing files and Delta tables in the GCS buckets below; secrets from
#          Secret Manager. Needs the buckets and the secret to exist (infra/).
DATA_PLATFORM_MODE=local

# ---- cloud mode only ------------------------------------------------------------------
GCP_PROJECT_ID=
GCS_LANDING_BUCKET=
GCS_LAKEHOUSE_BUCKET=
BQ_DATASET_GOLD=gold
# Google credentials file inside ./secrets/, mounted read-only (see secrets/README.md).
# Default: your user's Application Default Credentials, generated into secrets/gcloud/.
GCP_CREDENTIALS_FILE=gcloud/application_default_credentials.json

# ---- local mode only ------------------------------------------------------------------
# Incoming-webhook URL of the Google Chat space for task-failure alerts (Space → Apps &
# integrations → Webhooks). It embeds a key and a token: a secret. In cloud mode it is
# read from the Secret Manager secret `google-chat-webhook-url` instead. Empty = alerts
# degrade to a log warning.
GOOGLE_CHAT_WEBHOOK_URL=
